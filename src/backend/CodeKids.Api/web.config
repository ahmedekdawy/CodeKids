<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <system.webServer>
    <!-- Let ASP.NET Core handle CORS preflight. IIS OPTIONSVerbHandler returns 200 with no CORS headers. -->
    <handlers>
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <remove name="WebDAV" />
    </handlers>
    <modules>
      <remove name="WebDAVModule" />
    </modules>
    <security>
      <requestFiltering>
        <verbs allowUnlisted="true">
          <remove verb="OPTIONS" />
          <add verb="OPTIONS" allowed="true" />
        </verbs>
      </requestFiltering>
    </security>
  </system.webServer>
</configuration>
